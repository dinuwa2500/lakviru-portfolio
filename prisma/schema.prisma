generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Profile {
  id                String   @id @default(cuid())
  name              String   @default("Lakviru Perera")
  primaryTitle      String   @default("Software Engineer")
  heroSubtitle      String   @default("Building scalable software, modern web applications, and practical solutions using modern technologies.")
  bio               String
  location          String   @default("Sri Lanka / Remote")
  email             String   @default("contact@lakviru.dev")
  githubUrl         String   @default("https://github.com/lakviruperera")
  linkedinUrl       String   @default("https://linkedin.com/in/lakviruperera")
  twitterUrl        String?
  resumeUrl         String?  @default("/resume.pdf")
  avatarUrl         String?  @default("/avatar.png")
  isAvailableForWork Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Project {
  id                String    @id @default(cuid())
  slug              String    @unique
  githubRepoId      Int?      @unique
  githubName        String?
  githubFullName    String?
  githubUrl         String?
  githubDescription String?
  githubStars       Int       @default(0)
  githubForks       Int       @default(0)
  githubLanguage    String?
  githubLanguages   String?   @default("[]") // JSON array string
  githubTopics      String?   @default("[]") // JSON array string
  githubReadme      String?
  githubCreatedAt   DateTime?
  githubUpdatedAt   DateTime?

  // Admin-controlled customization fields
  customTitle       String?
  customDescription String?
  category          String    @default("Full-Stack")
  status            String    @default("PUBLISHED") // HIDDEN, PUBLISHED, FEATURED, ARCHIVED
  isFeatured        Boolean   @default(false)
  isVisible         Boolean   @default(true)
  displayOrder      Int       @default(0)
  thumbnail         String?
  screenshots       String?   @default("[]") // JSON array string
  problem           String?
  solution          String?
  myRole            String?
  features          String?   @default("[]") // JSON array string
  demoUrl           String?
  architecture      String?
  technologies      String?   @default("[]") // JSON array string
  lastSyncedAt      DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([isVisible])
  @@index([isFeatured])
  @@index([displayOrder])
}

model Skill {
  id           String   @id @default(cuid())
  name         String
  category     String   // LANGUAGES, FRONTEND, BACKEND, DATABASES, DEVOPS_CLOUD, TOOLS
  skillLevel   Int?     @default(85)
  icon         String?
  description  String?
  displayOrder Int      @default(0)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([displayOrder])
}

model Experience {
  id               String   @id @default(cuid())
  company          String
  position         String
  location         String?
  startDate        String
  endDate          String?
  isCurrent        Boolean  @default(false)
  description      String
  responsibilities String?  @default("[]") // JSON array string
  achievements     String?  @default("[]") // JSON array string
  technologies     String?  @default("[]") // JSON array string
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([displayOrder])
}

model Education {
  id           String   @id @default(cuid())
  institution  String
  degree       String
  field        String
  location     String?
  startDate    String
  endDate      String?
  isCurrent    Boolean  @default(false)
  description  String?
  grade        String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  subject    String
  message    String
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model SyncLog {
  id             String    @id @default(cuid())
  triggerType    String    @default("MANUAL")
  status         String    @default("SUCCESS")
  reposFound     Int       @default(0)
  reposNew       Int       @default(0)
  reposUpdated   Int       @default(0)
  reposUnchanged Int       @default(0)
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([startedAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
